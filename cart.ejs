<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>My Cart</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body style="background-color: #f4f4f4;">

    <nav class="navbar navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">Furniture Store</a>
            <a href="/" class="btn btn-sm btn-outline-light">Back to Shop</a>
        </div>
    </nav>

    <div class="container mt-4">
        <h3 class="mb-3">Shopping Cart</h3>
        
        <% if(cart.length == 0) { %>
            <div class="alert alert-warning">
                Your cart is empty. <a href="/">Go add some furniture!</a>
            </div>
        <% } else { %>
            <div class="row">
                <div class="col-md-8">
                    <table class="table table-bordered bg-white shadow-sm">
                        <tr class="table-light">
                            <th>Item Name</th>
                            <th>Price</th>
                            <th>Qty</th>
                            <th>Total</th>
                            <th>Remove</th>
                        </tr>
                        
                        <% cart.forEach(function(c) { %>
                            <tr>
                                <td><%= c.product.name %></td>
                                <td>₹<%= c.product.price %></td>
                                <td><%= c.quantity %></td>
                                <td>₹<%= c.product.price * c.quantity %></td>
                                <td>
                                    <form action="/remove-from-cart" method="POST">
                                        <input type="hidden" name="productId" value="<%= c.product._id %>">
                                        <button type="submit" class="btn btn-sm btn-danger">X</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    </table>
                    
                    <h4 class="text-success">Total Bill: ₹<%= grandTotal %></h4>
                </div>

                <div class="col-md-4">
                    <div class="card p-3 shadow-sm">
                        <h5 class="mb-3">Checkout Details</h5>
                        <form action="/checkout" method="POST">
                            <input type="text" name="customerName" class="form-control mb-2" placeholder="Your Name" required>
                            <input type="number" name="mobile" class="form-control mb-2" placeholder="Mobile No" required>
                            <textarea name="address" class="form-control mb-3" placeholder="Delivery Address" required></textarea>
                            
                            <label style="font-size: 14px; font-weight: bold;">Payment Method</label>
<select name="paymentMode" class="form-control mb-3" required>
    <option value="COD">Cash on Delivery</option>
    <option value="PayPal">PayPal Gateway (Test Mode API)</option>
    <option value="Card">Debit/Credit Card</option>
</select>
                            <button type="submit" class="btn btn-success w-100">Confirm Order</button>
                        </form>
                    </div>
                </div>
            </div>
        <% } %>
    </div>

</body>
</html>