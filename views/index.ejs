<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Furniture Store</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body style="background-color: #f4f4f4;">

    <nav class="navbar navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">Furniture Store</a>
            
            <div class="d-flex">
                <a href="/cart" class="btn btn-warning fw-bold">
                    My Cart (<%= cartCount %>)
                </a>
            </div>
        </div>
    </nav>

    <div class="container mt-4 text-center">
        <h4>Filter Category</h4>
        <div class="mt-2">
            <a href="/?category=All" class="btn btn-outline-dark m-1">All</a>
            <a href="/?category=Living Room" class="btn btn-outline-dark m-1">Living Room</a>
            <a href="/?category=Bedroom" class="btn btn-outline-dark m-1">Bedroom</a>
            <a href="/?category=Study %26 Office" class="btn btn-outline-dark m-1">Study</a>
            <a href="/?category=Dining" class="btn btn-outline-dark m-1">Dining</a>
        </div>
    </div>

    <div class="container mt-4">
        <div class="row">
            <% products.forEach(function(p) { %>
                <div class="col-md-3 mb-4">
                    <div class="card p-2 shadow-sm">
                        <img src="<%= p.image %>" class="card-img-top" alt="product image" style="height: 180px; object-fit: cover; border-radius: 5px;">
                        
                        <div class="card-body text-center p-2 mt-2">
                            <span style="font-size: 12px; color: gray;"><%= p.category %></span>
                            <h6 class="mt-1"><%= p.name %></h6>
                            <h5 class="text-success">₹<%= p.price %></h5>
                            
                            <form action="/add-to-cart" method="POST" class="mt-2">
                                <input type="hidden" name="productId" value="<%= p._id %>">
                                <button type="submit" class="btn btn-dark w-100">Add to Cart</button>
                            </form>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>

</body>
</html>
