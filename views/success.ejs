
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Order Done</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body style="background-color: #f4f4f4; text-align: center; padding-top: 80px;">

    <div class="container">
        <div class="card p-4 mx-auto shadow-sm" style="max-width: 450px;">
            <h2 class="text-success mb-3">Order Placed Successfully!</h2>
            <p>Thanks for shopping, <b><%= customerName %></b>.</p>
            <p>Please pay <b>₹<%= totalAmount %></b> on delivery.</p>
            
            <a href="/" class="btn btn-dark mt-3">Go Back to Home</a>
        </div>
    </div>

</body>
</html>
